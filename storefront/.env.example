# Copy to .env for local dev. On Netlify, add the same names under
# Site configuration › Environment variables. Never commit .env.

SESSION_SECRET="any-long-random-string"

# Storefront API (Shopify admin › Headless channel › your storefront › Storefront API)
PUBLIC_STORE_DOMAIN="your-store.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""
PUBLIC_CHECKOUT_DOMAIN="your-store.myshopify.com"

# Customer accounts (/account) — Headless channel › Customer Account API
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
SHOP_ID=""

# Luma: handle of the LC–01 product (defaults to lc-01)
PUBLIC_PRODUCT_HANDLE="lc-01"
